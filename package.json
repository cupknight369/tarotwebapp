{
  "name": "tarot",
  "version": "1.0.0",
  "description": "Tarot card drawing application",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "python3 -m http.server 8001",
    "ts:watch": "tsc --watch",
    "tw:watch": "tailwindcss -i input.css -o ./dist/output.css --watch",
    "dev": "concurrently -n server, typescript, tailwind \"npm run serve\" \"npm run ts:watch\" \"npm run tw:watch\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@types/alpinejs": "^3.13.10",
    "concurrently": "^5.3.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^4.9.5"
  }
}
