{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./server",
    "outDir": "./dist/server",
    "module": "Node16",
    "moduleResolution": "node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "noEmit": false
  },
  "include": ["server/**/*.ts"],
  "exclude": ["node_modules"]
}
