{
  "name": "tarot",
  "version": "1.0.0",
  "description": "Tarot card drawing application",
  "type": "module",
  "scripts": {
    "proto:generate": "pbjs -t static-module -w es6 -o src/proto/generated/bundle.js src/proto/cktarot.proto && pbts -o src/proto/generated/bundle.d.ts src/proto/generated/bundle.js",
    "dev": "node scripts/run-dev.mjs",
    "build": "npm run proto:generate && vite build && node scripts/build-server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase:restart": "npx supabase stop && npx supabase start",
    "dev:vite": "vite",
    "start": "node scripts/run-production.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/alpinejs": "^3.13.11",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.4",
    "@vituum/vite-plugin-posthtml": "^1.1.0",
    "concurrently": "^5.3.0",
    "esbuild": "^0.27.3",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.9",
    "posthtml": "^0.16.7",
    "posthtml-include": "^2.0.1",
    "prettier": "^3.8.1",
    "protobufjs-cli": "^2.0.0",
    "supabase": "^2.76.8",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.47.10",
    "alpinejs": "^3.15.8",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "protobufjs": "^7.5.4",
    "zod": "^3.25.76"
  }
}
